{
  "name": "te-cuento-una-historia-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "node scripts/prepare-content.mjs",
    "build": "npm run prepare && vite build && node scripts/copy-static.mjs",
    "optimize:assets": "node scripts/optimize-assets.mjs",
    "typecheck": "npm run prepare && tsc --noEmit",
    "preview": "npm run build && vite preview",
    "test:browser": "playwright test",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.0",
    "sharp": "^0.34.3",
    "typescript": "^5",
    "vite": "^7.1.3",
    "wrangler": "^4.31.0"
  }
}
