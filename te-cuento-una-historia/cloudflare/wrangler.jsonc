{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "te-cuento-una-historia",
  "compatibility_date": "2026-08-22",
  "assets": {
    "directory": "../.artifacts/cloudflare/dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
