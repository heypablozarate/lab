{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/components/rams/primitives": ["src/rams-wordmark.tsx"],
      "@/lib/lab-content": ["src/content-types.ts"],
      "@/lib/te-cuento-story-markdown": [
        "../../../../lib/te-cuento-story-markdown.ts"
      ]
    }
  },
  "include": [
    "src",
    "../experience-shell.tsx",
    "../*.js",
    "../../../../lib/te-cuento-story-markdown.ts"
  ]
}
